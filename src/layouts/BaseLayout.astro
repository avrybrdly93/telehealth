---
// Implements ARCHITECTURE.md §Repository Structure and BL-005 — base layout wiring
// SkipLink, SiteHeader, SiteFooter around each page's main content.
import '../styles/global.css';
import { SkipLink } from '../components/SkipLink/SkipLink';
import SiteHeader from '../components/SiteHeader/SiteHeader.astro';
import { SiteFooter } from '../components/SiteFooter/SiteFooter';
import { buildMedicalBusinessSchema, serializeJsonLd } from '../lib/structuredData';
import { withBase } from '../lib/routes';

interface Props {
  title: string;
  description: string;
  /** Root-relative path (from the base URL) to an OG/Twitter image; defaults to the site image. */
  image?: string;
}

const { title, description, image } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = new URL(currentPath, Astro.site);
const ogImageUrl = new URL(image ?? `${base}/images/og-default.jpg`, Astro.site);
// SEO_STRATEGY.md §Technical Foundation (FR-051, BL-031): MedicalBusiness is site-wide, same as
// the canonical/OG tags above.
const homeUrl = new URL(withBase('/'), Astro.site);
const medicalBusinessSchema = serializeJsonLd(buildMedicalBusinessSchema(homeUrl));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <!-- SEO_STRATEGY.md §Technical Foundation (FR-050/051, NFR-005): OG/Twitter tags per page. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={medicalBusinessSchema} is:inline />
    <!--
      Preload both self-hosted fonts (used on every page via --font-body/--font-display) so
      they arrive before first paint instead of swapping in after — without this, `font-display:
      swap`'s post-paint swap causes a real layout shift on shorter pages (found verifying
      BL-011: /services/medication-management measured CLS 0.15 against the 0.1 budget).
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}/fonts/inter-variable-latin.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}/fonts/source-serif-4-600-latin.woff2`}
      crossorigin
    />
  </head>
  <body>
    <SkipLink />
    <SiteHeader currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { initAnalytics } from '../lib/analytics.client';

      initAnalytics();
    </script>
  </body>
</html>
