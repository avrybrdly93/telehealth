---
// Implements ARCHITECTURE.md §Repository Structure and BL-005 — base layout wiring
// SkipLink, SiteHeader, SiteFooter around each page's main content.
import '../styles/global.css';
import { SkipLink } from '../components/SkipLink/SkipLink';
import SiteHeader from '../components/SiteHeader/SiteHeader.astro';
import { SiteFooter } from '../components/SiteFooter/SiteFooter';
import { buildMedicalBusinessSchema, serializeJsonLd } from '../lib/structuredData';
import { withBase } from '../lib/routes';
import { PLACEHOLDER_PRACTICE_NAME } from '../lib/practice';
import layoutStyles from './BaseLayout.module.css';

interface Props {
  title: string;
  description: string;
  /** Root-relative path (from the base URL) to an OG/Twitter image; defaults to the site image. */
  image?: string;
  /**
   * `'full'` (default): SiteHeader (nav/phone/Book button/mobile menu) + SiteFooter, used by
   * every content page. `'minimal'`: logo-only header, no footer — `/book`'s own reduced-chrome
   * spec (PAGE_SPECIFICATIONS.md §/book: "No footer nav (reduce exits)"), see DECISION_LOG.md
   * D-013. The caller is responsible for its own crisis-strip instance in `'minimal'` mode
   * (BookingFlow renders one) since SiteFooter's CrisisResources isn't rendered here.
   */
  chrome?: 'full' | 'minimal';
}

const { title, description, image, chrome = 'full' } = Astro.props;
const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const canonicalUrl = new URL(currentPath, Astro.site);
const ogImageUrl = new URL(image ?? `${base}/images/og-default.jpg`, Astro.site);
// SEO_STRATEGY.md §Technical Foundation (FR-051, BL-031): MedicalBusiness is site-wide, same as
// the canonical/OG tags above.
const homeUrl = new URL(withBase('/'), Astro.site);
const medicalBusinessSchema = serializeJsonLd(buildMedicalBusinessSchema(homeUrl));
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!--
      BL-033 / SECURITY_AND_COMPLIANCE_PLAN.md §Website Security Controls, D-012: best-effort
      client-side equivalents of the documented header set. GitHub Pages (the confirmed live
      deployment target — astro.config.mjs `output: 'static'`, deploy.yml's actions/deploy-pages)
      has NO mechanism to send custom HTTP response headers, so these two are delivered the only
      way a static host allows (meta tag) instead of as real headers. This is a real but partial
      mitigation, not equivalent to the full control set — see D-012 for what it does NOT cover:
        - X-Content-Type-Options, X-Frame-Options, Permissions-Policy, Strict-Transport-Security
          have no meta-tag equivalent at all and are not implemented anywhere in this build.
        - CSP's `frame-ancestors` directive (clickjacking protection) is silently ignored by
          browsers when CSP is delivered via meta rather than an HTTP header, so it is
          deliberately omitted below rather than included as a no-op that would look like
          protection in a code review but do nothing at runtime.
        - `script-src`/`style-src` include `'unsafe-inline'` because this build's own inline
          `<script type="module">` (SiteHeader's mobile-menu logic, D-011/BL-007) and Astro's
          inlined CSS module `<style>` blocks have no nonce or hash — a strict policy without
          `'unsafe-inline'` would break the mobile menu and page styling. This means CSP here
          does NOT protect against inline-script-injection XSS; it still blocks cross-origin
          script/resource loading, base-tag hijacking, and off-origin form submission.
    -->
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self';"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="canonical" href={canonicalUrl} />
    <!-- SEO_STRATEGY.md §Technical Foundation (FR-050/051, NFR-005): OG/Twitter tags per page. -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <script type="application/ld+json" set:html={medicalBusinessSchema} is:inline />
    <!--
      Preload both self-hosted fonts (used on every page via --font-body/--font-display) so
      they arrive before first paint instead of swapping in after — without this, `font-display:
      swap`'s post-paint swap causes a real layout shift on shorter pages (found verifying
      BL-011: /services/medication-management measured CLS 0.15 against the 0.1 budget).
    -->
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}/fonts/inter-variable-latin.woff2`}
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href={`${base}/fonts/source-serif-4-600-latin.woff2`}
      crossorigin
    />
  </head>
  <body>
    <SkipLink />
    {
      chrome === 'full' ? (
        <SiteHeader currentPath={currentPath} />
      ) : (
        <header class={layoutStyles.minimalHeader}>
          <a class={layoutStyles.logo} href={withBase('/')}>
            {PLACEHOLDER_PRACTICE_NAME}
          </a>
        </header>
      )
    }
    <main id="main-content">
      <slot />
    </main>
    {chrome === 'full' && <SiteFooter />}
    <script>
      import { initAnalytics } from '../lib/analytics.client';

      initAnalytics();
    </script>
  </body>
</html>
