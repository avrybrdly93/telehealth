---
// Implements ARCHITECTURE.md §Repository Structure and BL-005 — base layout wiring
// SkipLink, SiteHeader, SiteFooter around each page's main content.
import '../styles/global.css';
import { SkipLink } from '../components/SkipLink/SkipLink';
import SiteHeader from '../components/SiteHeader/SiteHeader.astro';
import { SiteFooter } from '../components/SiteFooter/SiteFooter';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <SkipLink />
    <SiteHeader currentPath={currentPath} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
