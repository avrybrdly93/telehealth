---
// Implements PAGE_SPECIFICATIONS.md `/pricing` (BL-013): PricingTable (initial evaluation +
// follow-up, exact prices/durations) · what's included · superbill explanation · cancellation
// policy · payment methods · "Why self-pay" · Book CTA. No asterisks or "starting at"
// (COPY_GUIDELINES.md).
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Button } from '../components/Button/Button';
import { PricingTable, type PricingRow } from '../components/PricingTable/PricingTable';
import {
  SERVICE_PRICES,
  PLACEHOLDER_CANCELLATION_POLICY,
  PLACEHOLDER_PAYMENT_METHODS,
} from '../lib/practice';
import styles from './pricing.module.css';

const services = await getCollection('services');

function durationLabel(min: number, max: number) {
  return min === max ? `${min} minutes` : `${min}–${max} minutes`;
}

const rows: PricingRow[] = services
  .sort((a, b) => a.data.order - b.data.order)
  .map((service) => ({
    name: service.data.name,
    durationLabel: durationLabel(service.data.durationMinutesMin, service.data.durationMinutesMax),
    price: SERVICE_PRICES[service.data.priceKey],
  }));
---

<BaseLayout
  title="Pricing — Self-Pay Psychiatric Care"
  description="Transparent self-pay pricing for video psychiatric evaluations and follow-up appointments. No insurance billing, no surprise costs."
>
  <section class={styles.section} aria-labelledby="pricing-heading">
    <h1 id="pricing-heading" class={styles.heading}>Pricing</h1>
    <p class={styles.intro}>
      We're a self-pay practice. That means clear prices, no insurance billing, and no surprise
      costs.
    </p>

    <PricingTable rows={rows} />

    <section class={styles.block} aria-labelledby="included-heading">
      <h2 id="included-heading" class={styles.blockHeading}>What's included</h2>
      <ul class={styles.list}>
        <li>The full appointment time with your provider</li>
        <li>A conversation about your history, current concerns, and goals</li>
        <li>A plan of care you help build</li>
        <li>A superbill you can submit to your insurance for possible reimbursement</li>
      </ul>
    </section>

    <section class={styles.block} aria-labelledby="superbills-heading">
      <h2 id="superbills-heading" class={styles.blockHeading}>Superbills</h2>
      <p class={styles.blockBody}>
        A superbill is an itemized receipt of your visit. You can send it to your insurance
        company to ask for reimbursement. We don't bill insurance directly, and we can't
        guarantee your plan will reimburse you.
      </p>
    </section>

    <section class={styles.block} aria-labelledby="cancellation-heading">
      <h2 id="cancellation-heading" class={styles.blockHeading}>Cancellation policy</h2>
      <p class={styles.blockBody}>{PLACEHOLDER_CANCELLATION_POLICY}</p>
    </section>

    <section class={styles.block} aria-labelledby="payment-heading">
      <h2 id="payment-heading" class={styles.blockHeading}>Payment methods</h2>
      <p class={styles.blockBody}>{PLACEHOLDER_PAYMENT_METHODS}</p>
    </section>

    <section class={styles.block} aria-labelledby="why-self-pay-heading">
      <h2 id="why-self-pay-heading" class={styles.blockHeading}>Why we don't bill insurance</h2>
      <p class={styles.blockBody}>
        Self-pay keeps your appointment time focused on care instead of paperwork. The price you
        see is the price you pay, and scheduling isn't limited by which plans a provider accepts.
      </p>
    </section>

    <div class={styles.cta}>
      <Button href="/book" size="large">Book an appointment</Button>
    </div>
  </section>
</BaseLayout>
