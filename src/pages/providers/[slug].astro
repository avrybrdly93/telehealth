---
// Implements PAGE_SPECIFICATIONS.md `/providers/[slug]` (BL-012): photo, name + full credential,
// CA license number, approach statement (first person, <=150 words), conditions treated,
// education/training list, Book CTA pre-selecting provider (/book?provider=slug).
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Button } from '../../components/Button/Button';
import {
  PROVIDER_NAMES,
  PROVIDER_CREDENTIALS,
  PROVIDER_LICENSE_NUMBERS,
  type ProviderKey,
} from '../../lib/practice';
import { withBase } from '../../lib/routes';
import styles from './provider-detail.module.css';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  return providers.map((provider) => ({
    params: { slug: provider.id },
    props: { provider },
  }));
}

const { provider } = Astro.props;
const { Content } = await render(provider);

const key = provider.data.providerKey as ProviderKey;
const name = PROVIDER_NAMES[key];
const credential = PROVIDER_CREDENTIALS[key];
const licenseNumber = PROVIDER_LICENSE_NUMBERS[key];

const conditions = await Promise.all(
  provider.data.conditionsTreated.map((ref) => getEntry(ref)),
);

// Real provider photos are Blocked/NEEDS_HUMAN (PROJECT_STATUS.md); a decorative placeholder
// stands in until real photos land — alt="" because it is not a photo of the named provider
// (D-005, DECISION_LOG.md). Once real photos ship, alt becomes "Photo of [Name], [Credential]"
// per IMAGE_GUIDELINES.md.
const PROVIDER_PHOTO_PLACEHOLDER = withBase('/images/provider-photo-placeholder.svg');
---

<BaseLayout title={`${name}, ${provider.data.role} — Providers`} description={provider.data.approachStatement}>
  <article class={styles.section}>
    <img class={styles.photo} src={PROVIDER_PHOTO_PLACEHOLDER} alt="" width="200" height="250" />
    <h1 class={styles.heading}>{name}, {credential}</h1>
    <p class={styles.licenseNumber}>California license {licenseNumber}</p>

    <section class={styles.block} aria-labelledby="approach-heading">
      <h2 id="approach-heading" class={styles.blockHeading}>Approach</h2>
      <p class={styles.approach}>{provider.data.approachStatement}</p>
      <div class={styles.content}>
        <Content />
      </div>
    </section>

    <section class={styles.block} aria-labelledby="conditions-heading">
      <h2 id="conditions-heading" class={styles.blockHeading}>Conditions treated</h2>
      <ul class={styles.list}>
        {conditions.map((condition) => <li>{condition.data.name}</li>)}
      </ul>
    </section>

    <section class={styles.block} aria-labelledby="education-heading">
      <h2 id="education-heading" class={styles.blockHeading}>Education & training</h2>
      <ul class={styles.list}>
        {provider.data.education.map((item) => <li>{item}</li>)}
      </ul>
    </section>

    <div class={styles.cta}>
      <Button href={withBase(`/book?provider=${provider.id}`)} size="large">
        Book with {name}
      </Button>
    </div>
  </article>
</BaseLayout>
