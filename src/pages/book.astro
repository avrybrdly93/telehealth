---
// Implements PAGE_SPECIFICATIONS.md §/book (Maya; FR-020-024, UX-010/011/020), USER_FLOWS.md
// Flow 1, BL-035/036, DECISION_LOG.md D-013. Minimal chrome (BaseLayout `chrome="minimal"`):
// logo, StepIndicator, step content, CrisisResources strip, phone alternative — no footer nav,
// per the spec's "reduce exits" note. BL-035 shipped Step 1 (service selection); BL-036 adds
// Step 2 (provider preference). Steps 3-4 are BL-037/BL-021.
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { BookingFlow, type BookingProviderOption } from '../components/BookingFlow/BookingFlow';
import { PLACEHOLDER_PHONE, PROVIDER_NAMES, PROVIDER_CREDENTIALS, type ProviderKey } from '../lib/practice';
import styles from './book.module.css';

// Same PROVIDER_NAMES/PROVIDER_CREDENTIALS placeholder pattern src/pages/providers/index.astro
// already uses — not new placeholder text, just this page's first read of those existing
// constants. Sorted by `order` (dr-md, np-pmhnp) to match every other provider listing's order.
const providerEntries = (await getCollection('providers')).sort((a, b) => a.data.order - b.data.order);
const providers: BookingProviderOption[] = providerEntries.map((entry) => {
  const key = entry.data.providerKey as ProviderKey;
  return {
    slug: entry.id,
    name: PROVIDER_NAMES[key],
    credentialLine: `${entry.data.role}, ${PROVIDER_CREDENTIALS[key]}`,
  };
});
---

<BaseLayout
  title="Book an Appointment"
  description="Start booking your appointment: choose a first appointment or follow-up visit."
  chrome="minimal"
>
  <BookingFlow phone={PLACEHOLDER_PHONE} providers={providers} client:load />

  {
    /*
      E-050: Astro server-renders every island's markup regardless of its client:* directive
      (`client:load` only controls when hydration/interactivity attaches) — so a no-JS visitor to
      /book already sees Step 1's real content (StepIndicator, CrisisResources strip, phone
      alternative, eligibility summary, both service options as native <input type="radio">,
      selectable without JS via ordinary browser radio-group behavior). What's genuinely missing
      without JS is persistence (selecting an option won't save to the URL/sessionStorage) and step
      navigation (Step 1's "Continue" button has no onClick without hydration, so a no-JS visitor
      is stuck on Step 1 — Step 2 (BL-036) exists but is unreachable, and Steps 3-4 (BL-037/021)
      don't exist yet regardless of JS), so a no-JS visitor still can't complete a real booking
      online. This note names that gap plainly instead of duplicating the CrisisResources strip
      already rendered above.
    */
  }
  <noscript>
    <p class={styles.noscriptText}>
      This form needs JavaScript to save your selection and continue booking online. Prefer to
      book by phone instead? Call <a href={`tel:${PLACEHOLDER_PHONE}`}>{PLACEHOLDER_PHONE}</a>.
    </p>
  </noscript>
</BaseLayout>
